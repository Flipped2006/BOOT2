{
    "files.autoGuessEncoding": false,
    "files.encoding": "utf8",
    "files.associations": {
        "*.h": "c",
        "*.c": "c"
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/mdk": true
    },
    "github.copilot.enable": {
        "*": true,
        "markdown": false,
        "plaintext": false
    },
    "Codegeex.SidebarUI.LanguagePreference": "中文"
}
